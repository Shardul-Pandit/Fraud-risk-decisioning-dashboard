# Copy to .env (which is gitignored) and fill in. On Streamlit Cloud, put the
# same keys in the app's Secrets settings instead.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Providers and models tried in order, as provider:model.
# LLM_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-2.5-flash-lite

# Optional limits.
# LLM_MAX_TOOL_STEPS=4
# LLM_MAX_PER_MINUTE=8
# LLM_MAX_PER_DAY=150
